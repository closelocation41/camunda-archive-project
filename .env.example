NODE_ENV=development
API_PORT=3000
WEB_PORT=4200
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
CAMUNDA_BASE_URL=http://camunda:8080/engine-rest
CAMUNDA_ADMIN_USER=demo
CAMUNDA_ADMIN_PASSWORD=demo
ARCHIVE_DATABASE_URL=postgresql://archive:archive@archive-db:5432/camunda_archive
CAMUNDA_DATABASE_URL=postgresql://camunda:camunda@camunda-db:5432/camunda
ARCHIVE_BATCH_SIZE=500
ARCHIVE_COMPLETED_OLDER_THAN_DAYS=7
ARCHIVE_FAILED_OLDER_THAN_DAYS=1
ARCHIVE_SUSPENDED_OLDER_THAN_DAYS=30
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=300
